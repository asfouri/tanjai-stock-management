# WARNING: Never commit .env — it contains real credentials. Copy this file to .env and fill in your values.
DATABASE_URL=
# For EXCEL_IMPORT_STORAGE=prisma on Supabase, use the session pooler URL
# ending in :5432 unless your network supports IPv6 or your project has the
# IPv4 add-on for the direct db.<project>.supabase.co:5432 URL. Include
# sslmode=require&connection_limit=1 when using the Supabase session pooler.
# Comma-separated origins allowed to call the API in browsers.
FRONTEND_URLS=http://localhost:3000,https://untangled-cattishly-speckled.ngrok-free.dev
# Directory containing the locally synchronized shared workbook. The Refresh
# action reopens an imported file with the same name from this directory.
EXCEL_IMPORT_DIR=
EXCEL_IMPORT_STORAGE=local
# When true, an automatic/manual refresh diffs the workbook against what is
# already stored and writes only the rows that changed, keeping the same import
# batch and preserving shipment tracking state. When false (default), a refresh
# fully replaces the batch (the original behavior). Enable and validate on
# staging before turning on in production.
EXCEL_INCREMENTAL_REFRESH=false
EXCEL_AUTO_REFRESH=false
# How often the shared folder is polled for changes.
EXCEL_REFRESH_INTERVAL_SECONDS=60
# How long a file must stop changing before it is considered ready to import.
EXCEL_STABILITY_SECONDS=10
# Minimum time between *automatic* refreshes of the same file. 43200 seconds
# means changes are applied twice per day (once every 12 hours). The manual
# "Refresh now" action ignores this and always runs immediately.
EXCEL_MIN_AUTO_REFRESH_INTERVAL_SECONDS=43200
# Alert when an API order is still absent from Excel after this many days.
ORDER_EXCEL_RECONCILIATION_DAYS=7

# Shopify custom app OAuth. Keep the client secret in backend/.env only.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_SCOPES=read_orders,read_fulfillments
SHOPIFY_APP_URL=https://enables-point-msie-great.trycloudflare.com
SHOPIFY_REDIRECT_URI=https://enables-point-msie-great.trycloudflare.com/shopify/callback
# Development: Shopify Dev Dashboard. Production: use the Shopify-generated app installation URL.
SHOPIFY_INSTALL_URL=https://dev.shopify.com/dashboard

# WooCommerce REST API authorization. Keep credentials and encryption secrets
# in backend/.env only; public routes are proxied by the Next.js frontend.
WOOCOMMERCE_APP_NAME=TanjAI Stock
WOOCOMMERCE_CALLBACK_URL=https://YOUR-PUBLIC-DOMAIN/woocommerce/callback
WOOCOMMERCE_RETURN_URL=https://YOUR-PUBLIC-DOMAIN/woocommerce/return
WOOCOMMERCE_WEBHOOK_BASE_URL=https://YOUR-PUBLIC-DOMAIN/webhooks/woocommerce
WOOCOMMERCE_CREDENTIALS_ENCRYPTION_KEY=replace_with_32_byte_secret

# Global TanjAI shipment tracking. Keep the API key backend-only.
TRACK17_API_KEY=your_17track_api_key
TRACK17_API_BASE_URL=https://api.17track.net/track/v2.4
TRACK17_WEBHOOK_URL=https://YOUR-PUBLIC-DOMAIN/webhooks/17track
TRACK17_ENABLED=true

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Enables the email/password dev-login flow and `local-dev:` bearer tokens.
# Leave unset/false in production — these tokens are not verified against
# Supabase and must never be accepted on a deployed environment.
LOCAL_DEV_AUTH_ENABLED=false

TANJAI_ADMIN_EMAIL=
TANJAI_ADMIN_PASSWORD=

BRAND_OWNER_EMAIL=
BRAND_OWNER_PASSWORD=

UFULFILL_EMAIL=
UFULFILL_PASSWORD=
