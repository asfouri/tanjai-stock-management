# WARNING: Never commit .env — it contains real credentials. Copy this file to .env and fill in your values.
DATABASE_URL=
# For EXCEL_IMPORT_STORAGE=prisma on Supabase, use the session pooler URL
# ending in :5432 unless your network supports IPv6 or your project has the
# IPv4 add-on for the direct db.<project>.supabase.co:5432 URL. Include
# sslmode=require&connection_limit=1 when using the Supabase session pooler.
# Comma-separated origins allowed to call the API in browsers.
FRONTEND_URLS=http://localhost:3000
EXCEL_IMPORT_DIR=
EXCEL_IMPORT_STORAGE=local

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

TANJAI_ADMIN_EMAIL=
TANJAI_ADMIN_PASSWORD=

BRAND_OWNER_EMAIL=
BRAND_OWNER_PASSWORD=

UFULFILL_EMAIL=
UFULFILL_PASSWORD=
